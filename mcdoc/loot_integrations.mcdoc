// Datapack schema for Loot Integrations (`data/lootintegrations/loot/*.json`).

dispatch minecraft:resource["lootintegrations:loot"] to struct LootIntegration {
	/// Source loot table whose rolled items are injected into the listed target tables.
	loot_table: #[id="loot_table"] string,
	/// Maximum total number of items injected into a single container.
	max_result_itemcount: int @ 0..,
	/// Map of target loot table ID to roll count weight (0 skips the table).
	integrated_loot_tables: struct {
		[#[id="loot_table"] string]: int @ 0..,
	},
}
